# ============================================================================
# Rentals Philly — environment variables
#
# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.
# ============================================================================

# ---- Supabase --------------------------------------------------------------
# From Supabase project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY     # secret — never expose

# ---- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
# Pick ONE of the next two:
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12155551234

# Set 'true' to skip signature verification on inbound/status webhooks during
# local dev (when Twilio is calling localhost via ngrok). Default: signatures
# are enforced in production.
TWILIO_SKIP_SIGNATURE=

# ---- Resend (email) --------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=morgan@rentalsphilly.com

# ---- Anthropic (AI features) -----------------------------------------------
# Drives: AI welcome draft on intake, suggest-reply in inbox, AI lead summary,
# auto-tag suggestions, weekly performance coach, scheduling-link 48h nudge
# copy. Without this, AI features silently fall back to static templates
# (welcome flow) or just don't surface (suggest-reply / tags). Get from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# ---- Kill switch -----------------------------------------------------------
# Until you've verified A2P and want to actually send real SMS / emails, leave
# this UNSET or set to 'false'. The app will log + record messages as
# 'simulated' instead of contacting Twilio / Resend.
ENABLE_REAL_SENDING=false

# ---- App URL (used to build webhook URLs) ----------------------------------
# In production this is your Vercel deployment, e.g. https://rentalsphilly.com
# In local dev, set to your ngrok URL when testing inbound webhooks.
NEXT_PUBLIC_APP_URL=https://rentalsphilly.vercel.app

# ---- Cron auth -------------------------------------------------------------
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Generate a random
# 32-byte hex string and put it here AND in Vercel env.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---- Admin allow-list (optional) -------------------------------------------
# By default the admin allow-list lives in lib/auth.js (just morganrentalsphilly@gmail.com).
# If you want to add teammates without redeploying code, set this var to a
# comma-separated list. When set, it REPLACES the hardcoded list.
# NEXT_PUBLIC_ADMIN_EMAILS=morganrentalsphilly@gmail.com,assistant@rentalsphilly.com

# ---- Optional: BrightMLS (not yet wired) -----------------------------------
# BRIGHTMLS_CLIENT_ID=
# BRIGHTMLS_CLIENT_SECRET=
# BRIGHTMLS_TOKEN_URL=https://...
# BRIGHTMLS_API_BASE=https://api.brightmls.com/...
